[Unit]
Description=Oceti Native AIOS heartbeat
After=network.target

[Service]
Type=oneshot
ExecStart=~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/bin/aios doctor
Environment=AIOS_NATIVE=~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios AIOS_ROOT=~/projects/Human-AI/projects/Human-AI/core/Autonomy
StandardOutput=append:~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/logs/heartbeat.log
StandardError=append:~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/logs/heartbeat.log
