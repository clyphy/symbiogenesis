[Unit]
Description=Oceti Native AIOS scan
After=network.target

[Service]
Type=oneshot
ExecStart=~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/bin/aios scan
Environment=AIOS_NATIVE=~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios AIOS_ROOT=~/projects/Human-AI/projects/Human-AI/core/Autonomy
StandardOutput=append:~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/logs/scan.log
StandardError=append:~/projects/Human-AI/projects/Human-AI/core/Autonomy/native_aios/logs/scan.log
